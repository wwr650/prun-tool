{
  "manifest_version": 3,
  "name": "PRUN 生产队列面板",
  "version": "0.1.0",
  "description": "在 APEX 里自定义生产队列，用 prunplanner 配方一键批量下单（默认干跑）",
  "content_scripts": [
    {
      "matches": ["https://apex.prosperousuniverse.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
